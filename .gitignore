# Logs
logs/
*.log

# Next.js build output
apps/console/.next/
# Written by `next dev`, `next build` and `next typegen`, which disagree about
# its contents, so no committed copy survives all three — every gates run left
# it modified (G-052). Next's own docs say to ignore it. The console's
# `npm run typecheck` runs `next typegen` first, so it exists before tsc reads it.
apps/console/next-env.d.ts

# tsc emits alongside sources when outDir is unset; never commit build output into src/
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map

# Test and Storybook output
apps/console/test-results/
apps/console/playwright-report/
apps/console/storybook-static/

# MCP plugin logs
logs/

# Playwright output. The root run misfires here when a command is invoked
# from the wrong directory; apps/console has its own ignore.
test-results/
playwright-report/
