{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Intermediate Representation (DIR) Schema",
  "description": "Versioned, immutable specification of a decision strategy",
  "type": "object",
  "required": ["id", "name", "version", "nodes", "edges", "entryNode", "exitNodes"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this strategy artifact",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the strategy",
      "minLength": 1,
      "maxLength": 255
    },
    "version": {
      "type": "string",
      "description": "Semantic version of this artifact",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "description": {
      "type": "string",
      "description": "Description of what this strategy does"
    },
    "nodes": {
      "type": "array",
      "description": "Array of decision nodes that comprise this strategy",
      "items": {
        "$ref": "#/definitions/Node"
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "description": "Array of edges connecting nodes",
      "items": {
        "$ref": "#/definitions/Edge"
      }
    },
    "entryNode": {
      "type": "string",
      "description": "ID of the entry node where execution begins"
    },
    "exitNodes": {
      "type": "array",
      "description": "IDs of all possible exit nodes",
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "packageDependencies": {
      "type": "object",
      "description": "Map of package IDs to version ranges",
      "additionalProperties": {
        "type": "string"
      }
    },
    "costAnnotations": {
      "type": "object",
      "description": "Annotations for cost analysis",
      "properties": {
        "maxSteps": {
          "type": "integer",
          "description": "Maximum execution steps allowed"
        },
        "estimatedP95LatencyMs": {
          "type": "integer",
          "description": "Estimated p95 latency in milliseconds"
        }
      }
    }
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this node (stable across versions for tracing)"
        },
        "type": {
          "type": "string",
          "enum": [
            "source",
            "filter",
            "set-property",
            "join",
            "aggregate",
            "group-by",
            "score-model",
            "score-adaptive",
            "prioritise",
            "switch",
            "sub-strategy",
            "champion-challenger",
            "interaction-history",
            "constraint",
            "suppress",
            "arbitrate",
            "explain-annotate"
          ],
          "description": "Type of decision node"
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for the node"
        },
        "packageId": {
          "type": "string",
          "description": "Package ID that defines this node type (optional, defaults to core)"
        },
        "packageVersion": {
          "type": "string",
          "description": "Package version constraint"
        },
        "config": {
          "type": "object",
          "description": "Node-specific configuration",
          "additionalProperties": true
        },
        "inputs": {
          "type": "object",
          "description": "Input schema for this node",
          "additionalProperties": {
            "$ref": "#/definitions/IOSpec"
          }
        },
        "outputs": {
          "type": "object",
          "description": "Output schema for this node",
          "additionalProperties": {
            "$ref": "#/definitions/IOSpec"
          }
        }
      }
    },
    "Edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "description": "ID of the source node"
        },
        "to": {
          "type": "string",
          "description": "ID of the target node"
        },
        "fromOutput": {
          "type": "string",
          "description": "Output slot on the source node (optional)"
        },
        "toInput": {
          "type": "string",
          "description": "Input slot on the target node (optional)"
        },
        "condition": {
          "type": "string",
          "description": "Optional condition for this edge"
        }
      }
    },
    "IOSpec": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the input or output"
        },
        "type": {
          "type": "string",
          "description": "Type specification (e.g., 'string', 'number', 'boolean', 'object')"
        },
        "required": {
          "type": "boolean",
          "description": "Whether this input is required",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Description of this input/output"
        }
      }
    }
  }
}
