{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@metis/nodes-core": [
        "../../packages/nodes-core/src"
      ],
      "@metis/compiler": [
        "../../packages/compiler/src"
      ],
      "@metis/runtime": [
        "../../packages/runtime/src"
      ],
      "@metis/client": [
        "../../packages/client/src"
      ],
      "@metis/core": [
        "../../packages/core/src"
      ],
      "@metis/compiler/*": [
        "../../packages/compiler/src/*"
      ],
      "@metis/runtime/*": [
        "../../packages/runtime/src/*"
      ],
      "@metis/core/*": [
        "../../packages/core/src/*"
      ],
      "@metis/*": [
        "../../packages/*/src"
      ],
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "vitest/globals"
    ],
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build"
  ]
}
