# Loaded by `next dev` only. Not by Vitest, not by a production build.
#
# Seeds the in-memory decision ledger with the generator's 10,400 decisions,
# their deliveries and their outcomes when the console runs without a database
# (ADR-018 §3). About twelve seconds at start, once per process; a store reset
# restores it without executing again. Unset to start without a history.
METIS_SEED_LEDGER=1
