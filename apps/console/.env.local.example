# apps/console/.env.local — what a local console can be told, and what it does.
#
# Copying this file unchanged changes nothing: every line below is commented out,
# and `tests/unit/env-example.test.ts` fails if one is not. Uncomment only what
# you want. `next dev` and `next build` read `.env.local`; it wins over
# `.env.development`, and a variable already set in your shell wins over both.
# The e2e harness sets METIS_DATABASE_URL and METIS_SEED_LEDGER on its own
# servers, so a database here never reaches them. Anything else you uncomment
# does — NEXT_PUBLIC_USE_MSW=true here would run the end-to-end suites against
# mocks.
#
# ─── Where the console's data comes from ─────────────────────────────────────
#
# Every request goes to the development API, `app/api/[...path]/route.ts`, over
# the store in `mocks/store.ts`. Without a database that store is in memory:
# the catalogue, flows and change sets are seeded from the fixture files on
# every start, and the decision ledger starts empty and is lost on restart.

# A PostgreSQL database for the four durable stores — catalogue, flows
# (registry), decision ledger, change sets and audit log (governance). Their
# migrations are applied when the console opens each store; nothing to run by
# hand. Use a database of its own: the unit suites empty `metis_registry_test`
# on every run. Create it once with `createdb -U postgres metis_dev`.
#
# What stays in memory with a database set: users, tenant settings, autonomy
# settings, agent activity and data sources, reseeded from the fixtures on every
# start (G-118). And a stored tenant is used as found: after the first start,
# edits to the catalogue, flow or change-set fixtures do not reach this database
# (G-149).
#
# METIS_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/metis_dev

# Schema migrations: `apply` or `verify`. Unset, a development console applies
# and a production build only verifies and refuses a database that is behind.
#
# METIS_MIGRATIONS=apply

# The generated history — 10,400 decisions, their deliveries and outcomes —
# executed into an in-memory ledger at start. `.env.development` sets 0, which is
# off; `npm run dev:seeded` turns it on for one run. Ignored when
# METIS_DATABASE_URL is set: seed a database with `npm run seed:ledger` instead.
#
# METIS_SEED_LEDGER=1

# `synthetic` or `real`. The console treats every ledger as synthetic whatever
# this says, and refuses `real` with a database while customer references are
# stored in clear (G-068). `npm run seed:ledger` requires `synthetic`.
#
# METIS_DATA_CLASS=synthetic

# ─── Mocking in the browser ──────────────────────────────────────────────────

# `true` starts a Mock Service Worker in the browser that answers 20 API
# operations from the fixture modules instead of the development API: sign-in
# and session, taxonomy, offers, creatives, targeting and frequency policies,
# arbitration, autonomy, agent activity, decision search, traces, replay, change
# sets with approve and reject, audit, and flows. Everything else still reaches
# the development API. So the console shows fixture decisions and fixture offers
# beside your real ledger and your real database, approvals do not persist, and
# nothing on screen says which is which. Leave it unset unless you are working on
# the handlers in `mocks/handlers.ts`.
#
# NEXT_PUBLIC_USE_MSW=true

# Where the browser sends API requests. Unset, it is `/api` on whatever port the
# console is on, which is almost always right; a fixed `http://localhost:3000/api`
# breaks a console started on another port.
#
# NEXT_PUBLIC_API_BASE=/api

# ─── Everything else the console reads ──────────────────────────────────────

# `live` resolves connector-supplied fields over HTTP. Unset, recorded responses.
#
# METIS_INTEGRATIONS=live

# `off` stops the in-memory log of API calls that `/integrations/traffic` shows.
#
# METIS_CALL_LOG=off

# The environment named in the header. Unset, `Development`.
#
# NEXT_PUBLIC_ENV_LABEL=Development

# Set by the e2e harness, never by hand: the harness's run token and its build
# directory, so it can refuse a server it did not start (G-035).
#
# METIS_E2E_RUN=
# NEXT_DIST_DIR=.next/e2e
