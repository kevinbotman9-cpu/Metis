  "dirSchema": {
    "id": "simple-filter-strategy",
    "name": "Simple Filter Strategy",
    "version": "1.0.0",
    "description": "Basic eligibility filter strategy",
    "nodes": [
      {
        "id": "source_1",
        "type": "source",
        "label": "Load Customer Data",
        "config": {
          "sourceId": "customer_profile",
          "estimatedMs": 5
        },
        "inputs": {
          "customerId": {
            "name": "customerId",
            "type": "string",
            "required": true
          }
        },
        "outputs": {
          "data": {
            "name": "data",
            "type": "object"
          }
        }
      },
      {
        "id": "filter_1",
        "type": "filter",
        "label": "Check Eligibility",
        "config": {
          "rule": "customer.active == true",
          "ruleId": "eligibility_active",
          "estimatedMs": 1
        },
        "inputs": {
          "value": {
            "name": "value",
            "type": "boolean",
            "required": true
          }
        },
        "outputs": {
          "pass": {
            "name": "pass",
            "type": "boolean"
          },
          "reason": {
            "name": "reason",
            "type": "string"
          }
        }
      },
      {
        "id": "arbitrate_1",
        "type": "arbitrate",
        "label": "Rank Offers",
        "config": {
          "formula": "propensity * value"
        },
        "inputs": {
          "candidates": {
            "name": "candidates",
            "type": "array",
            "required": true
          }
        },
        "outputs": {
          "ranked": {
            "name": "ranked",
            "type": "array"
          },
          "winner": {
            "name": "winner",
            "type": "string"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "source_1",
        "to": "filter_1"
      },
      {
        "from": "filter_1",
        "to": "arbitrate_1"
      }
    ],
    "entryNode": "source_1",
    "exitNodes": [
      "arbitrate_1"
    ],
    "packageDependencies": {
      "@metis/nodes-core": "1.0.0"
    }
  },
